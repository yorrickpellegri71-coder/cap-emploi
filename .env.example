VITE_SUPABASE_URL=https://<projet>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Schéma Postgres de Cap Emploi dans le projet hôte (par défaut : cap_emploi).
VITE_SUPABASE_SCHEMA=cap_emploi
# IA facultative : true seulement si la fonction serveur a la clé CAP_ANTHROPIC_API_KEY (payante à l'usage).
VITE_AI_ENABLED=false
# Facultatif : relevé des alertes e-mail (voir README).
VITE_GOOGLE_CLIENT_ID=
VITE_MS_CLIENT_ID=

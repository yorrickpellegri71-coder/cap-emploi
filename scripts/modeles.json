  "messages": {
    "fr": {
      "first_contact": {
        "subject": "Candidature spontanée – {company}",
        "body": "Bonjour {contact},\n\nJe suis {me}, {headline}. Je suis avec intérêt le développement de {company} et j'aimerais beaucoup échanger avec vous sur vos besoins à venir.\n\nAuriez-vous 15 minutes dans les prochains jours pour un court échange ?\n\nBien cordialement,\n{me}"
      },
      "followup": {
        "subject": "Suite à mon message – {company}",
        "body": "Bonjour {contact},\n\nJe me permets de revenir vers vous suite à mon message de la semaine dernière. Contribuer aux projets de {company} m'intéresse toujours beaucoup.\n\nSeriez-vous disponible pour un bref échange cette semaine ?\n\nBien cordialement,\n{me}"
      },
      "thanks": {
        "subject": "Merci pour notre entretien",
        "body": "Bonjour {contact},\n\nMerci pour le temps que vous m'avez accordé et pour la qualité de notre échange. Notre conversation a renforcé mon envie de rejoindre {company}.\n\nJe reste à votre disposition pour toute information complémentaire.\n\nBien cordialement,\n{me}"
      }
    },
    "en": {
      "first_contact": {
        "subject": "Introduction – {company}",
        "body": "Dear {contact},\n\nI am {me}, {headline}. I have been following {company}'s development with interest and would welcome the chance to discuss your upcoming needs.\n\nWould you have 15 minutes in the coming days for a short call?\n\nKind regards,\n{me}"
      },
      "followup": {
        "subject": "Following up – {company}",
        "body": "Dear {contact},\n\nI am following up on my message from last week. I remain very keen to contribute to {company}'s projects.\n\nWould you be available for a brief conversation this week?\n\nKind regards,\n{me}"
      },
      "thanks": {
        "subject": "Thank you for our meeting",
        "body": "Dear {contact},\n\nThank you for your time and for our conversation. It strengthened my wish to join {company}.\n\nI remain at your disposal for any further information.\n\nKind regards,\n{me}"
      }
    },
    "de": {
      "first_contact": {
        "subject": "Initiativbewerbung – {company}",
        "body": "Guten Tag {contact},\n\nmein Name ist {me}, {headline}. Ich verfolge die Entwicklung von {company} mit großem Interesse und würde mich über einen Austausch zu Ihrem künftigen Bedarf freuen.\n\nHätten Sie in den nächsten Tagen 15 Minuten für ein kurzes Gespräch?\n\nMit freundlichen Grüßen\n{me}"
      },
      "followup": {
        "subject": "Nachfrage zu meiner Nachricht – {company}",
        "body": "Guten Tag {contact},\n\nich komme auf meine Nachricht von letzter Woche zurück. Ich bin weiterhin sehr motiviert, zu den Projekten von {company} beizutragen.\n\nHätten Sie diese Woche Zeit für ein kurzes Gespräch?\n\nMit freundlichen Grüßen\n{me}"
      },
      "thanks": {
        "subject": "Vielen Dank für das Gespräch",
        "body": "Guten Tag {contact},\n\nvielen Dank für Ihre Zeit und das angenehme Gespräch. Es hat meinen Wunsch bestärkt, Teil von {company} zu werden.\n\nFür weitere Informationen stehe ich Ihnen gerne zur Verfügung.\n\nMit freundlichen Grüßen\n{me}"
      }
    }
  }
